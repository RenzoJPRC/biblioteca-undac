# ============================================================
# CONFIGURACIÓN FLASK
# ============================================================
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=tu_clave_secreta_aqui_64_caracteres_hexadecimales
PORT=5000
SESSION_COOKIE_SECURE=True

# ============================================================
# CONFIGURACIÓN SQL SERVER (NUBE SITE4NOW / LOCAL)
# ============================================================
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=sql8005.site4now.net
DB_DATABASE=db_acdcfa_bibliotecaundac
DB_USERNAME=tu_usuario_sql
DB_PASSWORD=tu_password_sql
DB_TRUSTED_CONNECTION=no

# ============================================================
# CONFIGURACIÓN ASISTENTE LLM (PROVEEDOR EXTERNO / MODO HÍBRIDO)
# ============================================================
# Proveedor configurable del servidor: 'gemini' o 'openai'
# Si es 'gemini', los valores predeterminados apuntan a Gemini Developer API
LLM_PROVEEDOR=gemini

# Activación explícita (true/false). Si es false, opera en modo local puro de respaldo
LLM_ACTIVADO=false

# Clave de API privada del proveedor (NUNCA se envía al cliente, logs ni código)
# Para Gemini: clave de API de Google AI Studio
LLM_API_KEY=

# Nombre del modelo a utilizar según disponibilidad en Google AI Studio (ej. gemini-2.0-flash o el indicado en tu cuenta)
LLM_MODELO=

# URL base de la API compatible con OpenAI
# Para Gemini Developer API (soporta con o sin barra final):
# https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Tiempo máximo de espera en segundos antes de activar fallback al motor local
LLM_TIMEOUT=10

# Presupuesto configurable y explícito de tokens para monitoreo en el panel (opcional, ej. 500000)
# Si se deja vacío, el panel de métricas muestra 'No configurado' sin calcular porcentajes
LLM_PRESUPUESTO_TOKENS=
